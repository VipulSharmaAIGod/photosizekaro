# ---- Required for production ----
# Public URL of the site (canonical URLs, sitemap, Open Graph). No trailing slash. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://photosizekaro.com

# Razorpay API keys (Dashboard → Account & Settings → API Keys). rzp_test_… for testing, rzp_live_… for real money.
# If empty: production shows "Payments launching soon"; dev / ALLOW_MOCK_PAYMENTS=true uses a clearly-labelled mock.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Random 32+ char secret used to sign unlock tokens (stateless, no DB). Generate: openssl rand -hex 32
# Falls back to RAZORPAY_KEY_SECRET if empty. Changing it invalidates previously issued unlocks.
UNLOCK_TOKEN_SECRET=

# ---- Recommended ----
# Razorpay webhook secret (Dashboard → Webhooks). Endpoint: https://YOUR_DOMAIN/api/payment/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# ---- Owner details shown on legal pages (replace the placeholders) ----
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_OWNER_CITY=

# Set to 1 to refuse mock payments even in development.
PAYMENTS_DISABLE_MOCK=
# Mock (simulated) payments are OFF whenever NODE_ENV=production unless this is exactly "true".
# Set it ONLY on your own machine (.env.local) for testing. NEVER set it on Render.
ALLOW_MOCK_PAYMENTS=
# Reserved for later; no ad code ships today (see src/components/site/AdSlot.tsx).
NEXT_PUBLIC_ADSENSE_CLIENT=
